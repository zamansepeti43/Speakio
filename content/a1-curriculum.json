  "units": [
    {"id":1,"title":"Selamlaşma ve Tanışma","emoji":"👋","goal":"Selamlaşmak, vedalaşmak ve kendini temel düzeyde tanıtmak.","grammar":"be: I am / you are","vocabulary":[["hello","merhaba"],["hi","selam"],["good morning","günaydın"],["good evening","iyi akşamlar"],["goodbye","hoşça kal"],["please","lütfen"],["thanks","teşekkürler"],["nice","hoş/güzel"]],"sentences":[["Hello!","Merhaba!"],["Hi, how are you?","Selam, nasılsın?"],["I am fine, thank you.","İyiyim, teşekkür ederim."],["My name is Ahmet.","Benim adım Ahmet."],["Nice to meet you.","Tanıştığıma memnun oldum."],["Good morning.","Günaydın."],["See you later.","Sonra görüşürüz."],["Goodbye!","Hoşça kal!"]],"dialogue":[["A","Hello! My name is Emma."],["B","Hi! I am Ahmet. Nice to meet you."],["A","Nice to meet you, too. How are you?"],["B","I am fine, thank you."]],"listening":["Hello!","Good morning.","How are you?","See you later."],"speaking":["Say hello and introduce yourself in three sentences.","Ask someone how they are."],"exercises":[{"type":"mcq","q":"'Günaydın' hangisidir?","options":["Good morning","Good night","Goodbye","Thanks"],"answer":0},{"type":"mcq","q":"'Benim adım Ahmet.' hangisidir?","options":["I am fine","My name is Ahmet","Nice to meet you","See you later"],"answer":1},{"type":"translate","q":"İyiyim, teşekkür ederim.","answer":"I am fine, thank you."},{"type":"build","q":"cümleyi kur","parts":["name","My","is","Ahmet"],"answer":"My name is Ahmet."}]},
    {"id":2,"title":"Kendini Tanıtma","emoji":"🙋","goal":"Ülke, şehir, yaş ve temel kişisel bilgiler hakkında konuşmak.","grammar":"be + from / basic personal information","vocabulary":[["name","isim"],["from","-den/-dan"],["country","ülke"],["city","şehir"],["live","yaşamak"],["work","çalışmak"],["student","öğrenci"],["years old","yaşında"]],"sentences":[["I am from Turkey.","Türkiye'denim."],["I live in Tavşanlı.","Tavşanlı'da yaşıyorum."],["I am twenty-nine years old.","Yirmi dokuz yaşındayım."],["I work in a factory.","Bir fabrikada çalışıyorum."],["I am a student.","Öğrenciyim."],["Where are you from?","Nerelisin?"],["Where do you live?","Nerede yaşıyorsun?"],["What do you do?","Ne iş yapıyorsun?"]],"dialogue":[["A","Where are you from?"],["B","I am from Turkey."],["A","Where do you live?"],["B","I live in Tavşanlı."],["A","What do you do?"],["B","I work in a factory."]],"listening":["I am from Turkey.","I live in a city.","I am twenty-nine years old.","I work in a factory."],"speaking":["Introduce yourself with your name, country, city and job.","Ask and answer three personal-information questions."],"exercises":[{"type":"mcq","q":"'Nerelisin?' hangisidir?","options":["Where do you live?","Where are you from?","What is your name?","How old are you?"],"answer":1},{"type":"mcq","q":"'Bir fabrikada çalışıyorum.'","options":["I work in a factory.","I live in a factory.","I am a factory.","I go factory."],"answer":0},{"type":"translate","q":"Türkiye'denim.","answer":"I am from Turkey."},{"type":"build","q":"cümleyi kur","parts":["live","I","Turkey","in"],"answer":"I live in Turkey."]}]},
    {"id":3,"title":"Sayılar, Saat ve Yaş","emoji":"🔢","goal":"Sayıları, fiyatları, yaşı ve temel saat ifadelerini kullanmak.","grammar":"numbers + o'clock + have/want","vocabulary":[["one","bir"],["five","beş"],["ten","on"],["fifteen","on beş"],["twenty","yirmi"],["hundred","yüz"],["time","saat/zaman"],["price","fiyat"]],"sentences":[["I am twenty-nine years old.","Yirmi dokuz yaşındayım."],["I want one coffee.","Bir kahve istiyorum."],["It is three o'clock.","Saat üç."],["It is ten o'clock.","Saat on."],["Fifteen dollars, please.","On beş dolar, lütfen."],["How much is it?","Ne kadar?"],["What time is it?","Saat kaç?"],["I have two brothers.","İki erkek kardeşim var."]],"dialogue":[["A","How much is this?"],["B","Fifteen dollars."],["A","Okay. What time is it?"],["B","It is three o'clock."]],"listening":["It is three o'clock.","Fifteen dollars.","I have two brothers.","I want one coffee."],"speaking":["Say your age and three numbers.","Ask the time and say a price."],"exercises":[{"type":"mcq","q":"'Saat üç.' hangisidir?","options":["It is three o'clock.","It is thirty.","Three time.","I am three."],"answer":0},{"type":"mcq","q":"15 İngilizce nasıl söylenir?","options":["Fifty","Fifteen","Five","Fifty-one"],"answer":1},{"type":"translate","q":"Ne kadar?","answer":"How much is it?"},{"type":"build","q":"cümleyi kur","parts":["old","years","twenty-nine","I","am"],"answer":"I am twenty-nine years old."]}]},
    {"id":4,"title":"Aile ve İnsanlar","emoji":"👨‍👩‍👦","goal":"Aile üyelerini tanıtmak ve sahiplik bildirmek.","grammar":"have/has + possessive adjectives","vocabulary":[["family","aile"],["wife","eş"],["husband","koca/eş"],["son","oğul"],["daughter","kız evlat"],["mother","anne"],["father","baba"],["brother","erkek kardeş"]],"sentences":[["This is my wife.","Bu benim eşim."],["I have a son.","Bir oğlum var."],["My family lives in Turkey.","Ailem Türkiye'de yaşıyor."],["I have one brother.","Bir erkek kardeşim var."],["I do not have a sister.","Kız kardeşim yok."],["This is my father.","Bu benim babam."],["Who is she?","O kim?"],["Who is he?","O kim?"]],"dialogue":[["A","Who is she?"],["B","She is my wife."],["A","Do you have children?"],["B","Yes. I have a son."]],"listening":["This is my wife.","I have a son.","My father is at home.","I have one brother."],"speaking":["Introduce two people in your family.","Say who you live with."],"exercises":[{"type":"mcq","q":"'Bir oğlum var.'","options":["I am a son.","I have a son.","I want a son.","My son is me."],"answer":1},{"type":"mcq","q":"'eşim' hangisidir?","options":["wife","sister","daughter","mother"],"answer":0},{"type":"translate","q":"Bu benim babam.","answer":"This is my father."},{"type":"build","q":"cümleyi kur","parts":["family","My","Turkey","lives","in"],"answer":"My family lives in Turkey."]}]},
    {"id":5,"title":"Yiyecek ve İçecek","emoji":"🍎","goal":"Yemek sipariş etmek, istek belirtmek ve restoranda temel iletişim kurmak.","grammar":"I want / Can I have / countable nouns","vocabulary":[["water","su"],["coffee","kahve"],["tea","çay"],["bread","ekmek"],["apple","elma"],["food","yiyecek"],["delicious","lezzetli"],["bill","hesap"]],"sentences":[["I want an apple.","Bir elma istiyorum."],["Water, please.","Su, lütfen."],["This is delicious.","Bu çok lezzetli."],["Can I have the bill?","Hesabı alabilir miyim?"],["I would like a coffee.","Bir kahve istiyorum."],["I am hungry.","Açım."],["I am thirsty.","Susadım."],["Can I have some water?","Biraz su alabilir miyim?"]],"dialogue":[["A","Hello. Can I have a coffee, please?"],["B","Sure. Anything else?"],["A","Some water, please."],["B","Of course."],["A","Can I have the bill?"],["B","Sure."]],"listening":["Water, please.","I am hungry.","This is delicious.","Can I have the bill?"],"speaking":["Order a drink and a meal.","Ask for the bill politely."],"exercises":[{"type":"mcq","q":"'Su, lütfen.'","options":["Water, please.","Water is there.","Please eat water.","I have water."],"answer":0},{"type":"mcq","q":"'Hesabı alabilir miyim?'","options":["Can I have the bill?","Can I eat the bill?","Where is the food?","I want money."],"answer":0},{"type":"translate","q":"Bu çok lezzetli.","answer":"This is delicious."},{"type":"build","q":"cümleyi kur","parts":["have","Can","bill","the","I"],"answer":"Can I have the bill?"]}]},
    {"id":6,"title":"Ev ve Eşyalar","emoji":"🏠","goal":"Evdeki temel yerleri ve nesneleri tarif etmek.","grammar":"there is/are + prepositions","vocabulary":[["home","ev"],["house","ev"],["room","oda"],["kitchen","mutfak"],["bathroom","banyo"],["door","kapı"],["table","masa"],["chair","sandalye"]],"sentences":[["I am at home.","Evdeyim."],["Where is the kitchen?","Mutfak nerede?"],["Open the door.","Kapıyı aç."],["The room is very big.","Oda çok büyük."],["There is a table in the kitchen.","Mutfakta bir masa var."],["The bathroom is small.","Banyo küçük."],["The door is open.","Kapı açık."],["There are two chairs.","İki sandalye var."]],"dialogue":[["A","Where is the kitchen?"],["B","It is next to the living room."],["A","Is there a table?"],["B","Yes, there is a table."]],"listening":["I am at home.","Open the door.","The room is very big.","There is a table."],"speaking":["Describe your room with three sentences.","Say where two objects are."],"exercises":[{"type":"mcq","q":"'Mutfak nerede?'","options":["Where is the kitchen?","What is the kitchen?","Who is the kitchen?","How is kitchen?"],"answer":0},{"type":"mcq","q":"'Mutfakta bir masa var.'","options":["There is a table in the kitchen.","The kitchen is a table.","There are kitchen table.","I table kitchen."],"answer":0},{"type":"translate","q":"Evdeyim.","answer":"I am at home."},{"type":"build","q":"cümleyi kur","parts":["room","big","The","is","very"],"answer":"The room is very big."]}]},
    {"id":7,"title":"Günlük Rutin","emoji":"⏰","goal":"Günlük alışkanlıkları ve zaman sırasını anlatmak.","grammar":"present simple: I work / I get up / I go","vocabulary":[["get up","kalkmak"],["wake up","uyanmak"],["work","çalışmak"],["start","başlamak"],["finish","bitirmek"],["bus","otobüs"],["return","dönmek"],["every day","her gün"]],"sentences":[["I work every day.","Her gün çalışırım."],["I get up at seven.","Saat yedide kalkarım."],["I take the bus.","Otobüse binerim."],["I return home in the evening.","Akşam eve dönerim."],["I start work at eight.","Saat sekizde işe başlarım."],["I have breakfast in the morning.","Sabah kahvaltı yaparım."],["I finish work at five.","Saat beşte işi bitiririm."],["I go to bed at eleven.","Saat on birde yatarım."]],"dialogue":[["A","What time do you get up?"],["B","I get up at seven."],["A","How do you go to work?"],["B","I take the bus."],["A","What time do you finish?"],["B","I finish at five."]],"listening":["I get up at seven.","I take the bus.","I start work at eight.","I go to bed at eleven."],"speaking":["Describe your morning.","Describe your workday in four steps."],"exercises":[{"type":"mcq","q":"'Saat yedide kalkarım.'","options":["I get up at seven.","I go at seven.","I wake seven.","I am seven."],"answer":0},{"type":"mcq","q":"'Otobüse binerim.'","options":["I take the bus.","I make the bus.","I have bus.","I am bus."],"answer":0},{"type":"translate","q":"Her gün çalışırım.","answer":"I work every day."},{"type":"build","q":"cümleyi kur","parts":["home","return","I","in","the","evening"],"answer":"I return home in the evening."]}]},
    {"id":8,"title":"İş ve Meslek","emoji":"💼","goal":"İşini, görevlerini ve yardım taleplerini ifade etmek.","grammar":"present simple + can/can't","vocabulary":[["job","iş"],["factory","fabrika"],["busy","meşgul"],["help","yardım etmek"],["manager","yönetici"],["worker","işçi"],["break","mola"],["today","bugün"]],"sentences":[["Where do you work?","Nerede çalışıyorsun?"],["I work in a factory.","Bir fabrikada çalışıyorum."],["I am busy today.","Bugün meşgulüm."],["Can you help me?","Bana yardım edebilir misin?"],["I start work at eight.","Saat sekizde işe başlarım."],["I need a break.","Molaya ihtiyacım var."],["I can do this.","Bunu yapabilirim."],["I cannot come today.","Bugün gelemem."]],"dialogue":[["A","Are you busy today?"],["B","Yes, I am very busy."],["A","Can you help me?"],["B","Yes, I can help you."]],"listening":["I work in a factory.","I am busy today.","Can you help me?","I need a break."],"speaking":["Say where you work and what you do.","Ask a colleague for help."],"exercises":[{"type":"mcq","q":"'Bana yardım edebilir misin?'","options":["Can you help me?","Do you work me?","Are you help?","Can I help you?"],"answer":0},{"type":"mcq","q":"'Bugün meşgulüm.'","options":["I am busy today.","I work today busy.","Today I help.","I am today."],"answer":0},{"type":"translate","q":"Molaya ihtiyacım var.","answer":"I need a break."},{"type":"build","q":"cümleyi kur","parts":["factory","in","I","work","a"],"answer":"I work in a factory."]}]},
    {"id":9,"title":"Şehir ve Yönler","emoji":"🧭","goal":"Yer sormak, yön tarif etmek ve mesafe belirtmek.","grammar":"where + imperatives + near/far","vocabulary":[["station","istasyon"],["street","sokak"],["right","sağ"],["left","sol"],["straight","düz"],["near","yakın"],["far","uzak"],["corner","köşe"]],"sentences":[["Where is the station?","İstasyon nerede?"],["Turn right.","Sağa dön."],["Turn left.","Sola dön."],["Go straight.","Düz git."],["It is very close.","Çok yakın."],["It is far from here.","Buradan uzak."],["The station is on the left.","İstasyon solda."],["It is on the corner.","Köşede."]],"dialogue":[["A","Excuse me. Where is the station?"],["B","Go straight and turn right."],["A","Is it far?"],["B","No. It is very close."]],"listening":["Turn right.","Turn left.","Go straight.","It is very close."],"speaking":["Give directions from your home to a shop.","Ask for the station."],"exercises":[{"type":"mcq","q":"'Sağa dön.'","options":["Turn right.","Turn left.","Go straight.","Stop right."],"answer":0},{"type":"mcq","q":"'Düz git.'","options":["Go straight.","Go left.","Go home.","Turn straight."],"answer":0},{"type":"translate","q":"İstasyon nerede?","answer":"Where is the station?"},{"type":"build","q":"cümleyi kur","parts":["very","It","close","is"],"answer":"It is very close."]}]},
    {"id":10,"title":"Alışveriş","emoji":"🛍️","goal":"Fiyat sormak, ürün istemek, denemek ve ödeme yapmak.","grammar":"this/that + can I + comparative cheaper","vocabulary":[["price","fiyat"],["cheap","ucuz"],["expensive","pahalı"],["cheaper","daha ucuz"],["size","beden"],["try","denemek"],["card","kart"],["cash","nakit"]],"sentences":[["How much is this?","Bu ne kadar?"],["I want to try this.","Bunu denemek istiyorum."],["Can I pay by card?","Kartla ödeyebilir miyim?"],["Is there a cheaper one?","Daha ucuzu var mı?"],["This is too expensive.","Bu çok pahalı."],["Do you have a bigger size?","Daha büyük beden var mı?"],["I will take it.","Bunu alacağım."],["Can I see that one?","Şuna bakabilir miyim?"]],"dialogue":[["A","How much is this?"],["B","It is twenty dollars."],["A","Is there a cheaper one?"],["B","Yes, this one is fifteen dollars."],["A","Can I pay by card?"],["B","Yes, of course."]],"listening":["How much is this?","This is too expensive.","Can I pay by card?","I will take it."],"speaking":["Ask the price and ask for a cheaper option.","Buy an item using a card."],"exercises":[{"type":"mcq","q":"'Bu ne kadar?'","options":["How much is this?","How many is this?","What is this price?","How is this?"],"answer":0},{"type":"mcq","q":"'Kartla ödeyebilir miyim?'","options":["Can I pay by card?","Can I take a card?","Do I have card?","Can card pay me?"],"answer":0},{"type":"translate","q":"Daha ucuzu var mı?","answer":"Is there a cheaper one?"},{"type":"build","q":"cümleyi kur","parts":["pay","Can","card","I","by"],"answer":"Can I pay by card?"]}]},
    {"id":11,"title":"Seyahat ve Otel","emoji":"✈️","goal":"Bilet, otel ve ulaşım hakkında temel ihtiyaçları ifade etmek.","grammar":"where/what time + need/want","vocabulary":[["ticket","bilet"],["airport","havaalanı"],["hotel","otel"],["room","oda"],["flight","uçuş"],["leave","ayrılmak"],["arrive","varmak"],["help","yardım"]],"sentences":[["Where is my ticket?","Biletim nerede?"],["Where is the hotel?","Otel nerede?"],["What time does it leave?","Saat kaçta kalkıyor?"],["I need help.","Yardıma ihtiyacım var."],["I have a reservation.","Rezervasyonum var."],["I need a room.","Bir odaya ihtiyacım var."],["Where is the airport?","Havaalanı nerede?"],["What time do we arrive?","Saat kaçta varıyoruz?"]],"dialogue":[["A","Hello. I have a reservation."],["B","Welcome. What is your name?"],["A","My name is Ahmet."],["B","Here is your room key."],["A","Thank you."],["B","You're welcome."]],"listening":["Where is my ticket?","Where is the hotel?","I need help.","I have a reservation."],"speaking":["Check in at a hotel.","Ask where your flight leaves from."],"exercises":[{"type":"mcq","q":"'Rezervasyonum var.'","options":["I have a reservation.","I need a reservation.","I am reservation.","My room is reservation."],"answer":0},{"type":"mcq","q":"'Yardıma ihtiyacım var.'","options":["I need help.","I have help.","Help me room.","I want a ticket."],"answer":0},{"type":"translate","q":"Otel nerede?","answer":"Where is the hotel?"},{"type":"build","q":"cümleyi kur","parts":["need","I","help"],"answer":"I need help."]}]},

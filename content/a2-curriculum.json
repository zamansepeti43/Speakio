{"course":{"id":"en-a2","language":"English","nativeLanguage":"Turkish","level":"A2","title":"İngilizce A2","description":"Günlük konuşmaları daha uzun ve doğal cümlelerle kur."},"units":[{"id":1,"title":"Günlük Hayat","emoji":"☀️","goal":"Günlük alışkanlıklarını anlat.","grammar":"Present simple + frequency adverbs","vocabulary":[["usually","genellikle"],["sometimes","bazen"],["always","her zaman"],["never","asla"],["early","erken"],["late","geç"],["busy","meşgul"],["free","boş"]],"sentences":[["I usually get up early.","Genellikle erken kalkarım."],["I sometimes walk to work.","Bazen işe yürüyerek giderim."],["I am busy in the morning.","Sabahları meşgulüm."],["I am free after six.","Altıdan sonra boşum."]],"dialogue":["What do you usually do?","I usually work until six."],"listening":["I usually get up early.","She is busy in the morning.","We sometimes walk home.","I am free after six."],"speaking":["Describe your daily routine.","Tell me when you are usually free."],"exercises":[{"type":"mcq","q":"What does usually mean?","options":["genellikle","asla","geç","bazen"],"answer":0},{"type":"mcq","q":"Choose the correct sentence.","options":["I usually get up early.","I early usually get up.","Usually I up get early.","I get usually early up."],"answer":0},{"type":"translate","q":"Genellikle işe erken giderim.","answer":"I usually go to work early."},{"type":"build","q":"Cümleyi kur.","parts":["usually","I","early","get","up"],"answer":"I usually get up early."}]},{"id":2,"title":"Geçmiş Hafta Sonu","emoji":"📅","goal":"Geçmişte yaptıklarını anlat.","grammar":"Past simple: was/were and regular verbs","vocabulary":[["yesterday","dün"],["last","geçen"],["visited","ziyaret etti"],["stayed","kaldı"],["watched","izledi"],["played","oynadı"],["cleaned","temizledi"],["worked","çalıştı"]],"sentences":[["I visited my friend yesterday.","Dün arkadaşımı ziyaret ettim."],["We watched a film last night.","Dün gece film izledik."],["I stayed at home.","Evde kaldım."],["She worked on Saturday.","Cumartesi çalıştı."]],"dialogue":["What did you do yesterday?","I watched a film at home."],"listening":["I visited my friend yesterday.","We watched a film last night.","I stayed at home.","She worked on Saturday."],"speaking":["Talk about your last weekend.","Say three things you did yesterday."],"exercises":[{"type":"mcq","q":"Choose the past form of watch.","options":["watched","watching","watches","watch"],"answer":0},{"type":"mcq","q":"Which is correct?","options":["I visited my friend.","I visit my friend yesterday.","I visiting my friend.","I visits my friend."],"answer":0},{"type":"translate","q":"Dün evde kaldım.","answer":"I stayed at home yesterday."},{"type":"build","q":"Cümleyi kur.","parts":["yesterday","I","at","home","stayed"],"answer":"I stayed at home yesterday."}]},{"id":3,"title":"Planlar ve Gelecek","emoji":"🔮","goal":"Plan ve niyetlerinden bahset.","grammar":"be going to","vocabulary":[["tomorrow","yarın"],["plan","plan"],["visit","ziyaret etmek"],["travel","seyahat etmek"],["meet","buluşmak"],["decide","karar vermek"],["soon","yakında"],["next","gelecek"]],"sentences":[["I am going to travel next month.","Gelecek ay seyahat edeceğim."],["We are going to meet tomorrow.","Yarın buluşacağız."],["She is going to visit her family.","Ailesini ziyaret edecek."],["I am going to study tonight.","Bu gece ders çalışacağım."]],"dialogue":["What are you going to do?","I am going to visit my family."],"listening":["I am going to travel next month.","We are going to meet tomorrow.","She is going to visit her family.","I am going to study tonight."],"speaking":["Talk about your plans for tomorrow.","Describe one plan for next month."],"exercises":[{"type":"mcq","q":"Which phrase talks about a plan?","options":["be going to","was","usually","there is"],"answer":0},{"type":"mcq","q":"Choose the correct sentence.","options":["I am going to travel.","I going to am travel.","I am travel going to.","I going travel to."],"answer":0},{"type":"translate","q":"Yarın arkadaşlarımla buluşacağım.","answer":"I am going to meet my friends tomorrow."},{"type":"build","q":"Cümleyi kur.","parts":["tomorrow","meet","I","am","going","to","friends","my"],"answer":"I am going to meet my friends tomorrow."}]},{"id":4,"title":"Karşılaştırmalar","emoji":"⚖️","goal":"İnsanları ve şeyleri karşılaştır.","grammar":"comparatives: bigger, more interesting","vocabulary":[["cheap","ucuz"],["expensive","pahalı"],["easy","kolay"],["difficult","zor"],["fast","hızlı"],["slow","yavaş"],["better","daha iyi"],["worse","daha kötü"]],"sentences":[["This car is faster than mine.","Bu araba benimkinden daha hızlı."],["English is easier than I expected.","İngilizce beklediğimden daha kolay."],["This phone is more expensive.","Bu telefon daha pahalı."],["Today is better than yesterday.","Bugün dünden daha iyi."]],"dialogue":["Which one is cheaper?","The blue one is cheaper."],"listening":["This car is faster than mine.","English is easier than I expected.","This phone is more expensive.","Today is better than yesterday."],"speaking":["Compare two phones.","Compare two places you know."],"exercises":[{"type":"mcq","q":"What is the comparative of fast?","options":["faster","fastest","more fast","fastly"],"answer":0},{"type":"mcq","q":"Choose the correct sentence.","options":["This one is cheaper than that one.","This one cheaper than that one.","This one is cheap than that one.","This one is more cheap than that one."],"answer":0},{"type":"translate","q":"Bu yol diğerinden daha kısa.","answer":"This road is shorter than the other one."},{"type":"build","q":"Cümleyi kur.","parts":["is","than","this","cheaper","one","that","one"],"answer":"This one is cheaper than that one."}]},{"id":5,"title":"Yemek ve Restoran","emoji":"🍽️","goal":"Restoranda doğal isteklerde bulun.","grammar":"would like / countable and uncountable nouns","vocabulary":[["menu","menü"],["order","sipariş"],["bill","hesap"],["water","su"],["dessert","tatlı"],["hungry","aç"],["thirsty","susamış"],["delicious","lezzetli"]],"sentences":[["I would like some water.","Biraz su istiyorum."],["Can I see the menu?","Menüyü görebilir miyim?"],["The food was delicious.","Yemek lezzetliydi."],["Can we have the bill, please?","Hesabı alabilir miyiz lütfen?"]],"dialogue":["Are you ready to order?","Yes, I would like chicken, please."],"listening":["I would like some water.","Can I see the menu?","The food was delicious.","Can we have the bill, please?"],"speaking":["Order a meal in English.","Ask for the bill politely."],"exercises":[{"type":"mcq","q":"Which is a polite restaurant request?","options":["I would like some water.","Give water.","Water now.","I water."],"answer":0},{"type":"mcq","q":"What do you ask for after eating?","options":["the bill","the airport","the passport","the map"],"answer":0},{"type":"translate","q":"Menüyü görebilir miyim?","answer":"Can I see the menu?"},{"type":"build","q":"Cümleyi kur.","parts":["like","would","I","some","water"],"answer":"I would like some water."}]},{"id":6,"title":"Sağlık ve Hisler","emoji":"❤️","goal":"Basit sağlık sorunlarını anlat.","grammar":"have/has + symptoms; should","vocabulary":[["headache","baş ağrısı"],["stomachache","karın ağrısı"],["tired","yorgun"],["sick","hasta"],["rest","dinlenmek"],["medicine","ilaç"],["doctor","doktor"],["better","daha iyi"]],"sentences":[["I have a headache.","Başım ağrıyor."],["You should get some rest.","Biraz dinlenmelisin."],["I feel tired today.","Bugün yorgun hissediyorum."],["I hope you feel better.","Umarım daha iyi hissedersin."]],"dialogue":["What's wrong?","I have a headache."],"listening":["I have a headache.","You should get some rest.","I feel tired today.","I hope you feel better."],"speaking":["Describe a simple health problem.","Give one piece of health advice."],"exercises":[{"type":"mcq","q":"Which word means baş ağrısı?","options":["headache","backpack","breakfast","holiday"],"answer":0},{"type":"mcq","q":"Choose the advice sentence.","options":["You should rest.","You rest yesterday.","You resting now.","You are rest."],"answer":0},{"type":"translate","q":"Kendimi yorgun hissediyorum.","answer":"I feel tired."},{"type":"build","q":"Cümleyi kur.","parts":["should","some","you","rest","get"],"answer":"You should get some rest."}]},{"id":7,"title":"Ev ve Mahalle","emoji":"🏠","goal":"Yaşadığın yeri daha ayrıntılı anlat.","grammar":"there is/are + prepositions","vocabulary":[["neighborhood","mahalle"],["corner","köşe"],["opposite","karşısında"],["between","arasında"],["near","yakınında"],["quiet","sessiz"],["noisy","gürültülü"],["building","bina"]],"sentences":[["There is a shop near my house.","Evimin yakınında bir dükkân var."],["The bank is opposite the school.","Banka okulun karşısında."],["My neighborhood is quiet.","Mahallem sessiz."],["The cafe is between the bank and the hotel.","Kafe banka ve otelin arasında."]],"dialogue":["Is there a pharmacy nearby?","Yes, it is opposite the bank."],"listening":["There is a shop near my house.","The bank is opposite the school.","My neighborhood is quiet.","The cafe is between the bank and the hotel."],"speaking":["Describe your neighborhood.","Give directions to a nearby place."],"exercises":[{"type":"mcq","q":"What does opposite mean?","options":["karşısında","içinde","altında","uzakta"],"answer":0},{"type":"mcq","q":"Choose the correct sentence.","options":["There is a shop near my house.","There are a shop near my house.","There is shop near my house.","There a shop is near my house."],"answer":0},{"type":"translate","q":"Evin yakınında bir kafe var.","answer":"There is a cafe near the house."},{"type":"build","q":"Cümleyi kur.","parts":["is","a","near","there","shop","my","house"],"answer":"There is a shop near my house."}]},{"id":8,"title":"İş ve Deneyim","emoji":"💼","goal":"İş deneyimini ve becerilerini anlat.","grammar":"present perfect basics: have/has + past participle","vocabulary":[["experience","deneyim"],["skill","beceri"],["company","şirket"],["project","proje"],["learn","öğrenmek"],["improve","geliştirmek"],["already","zaten"],["yet","henüz"]],"sentences":[["I have worked here for two years.","Burada iki yıldır çalışıyorum."],["I have learned a lot.","Çok şey öğrendim."],["She has already finished the project.","Projeyi çoktan bitirdi."],["I haven't finished it yet.","Henüz bitirmedim."]],"dialogue":["Have you finished the project?","Yes, I have already finished it."],"listening":["I have worked here for two years.","I have learned a lot.","She has already finished the project.","I haven't finished it yet."],"speaking":["Talk about your work experience.","Describe one skill you have learned."],"exercises":[{"type":"mcq","q":"Which word completes 'I have ___ a lot'?","options":["learned","learn","learning","learns"],"answer":0},{"type":"mcq","q":"Choose the present perfect sentence.","options":["I have finished the project.","I finished tomorrow.","I am finish the project.","I have finish the project."],"answer":0},{"type":"translate","q":"Çok şey öğrendim.","answer":"I have learned a lot."},{"type":"build","q":"Cümleyi kur.","parts":["have","I","learned","a","lot"],"answer":"I have learned a lot."}]},{"id":9,"title":"Seyahat Sorunları","emoji":"✈️","goal":"Seyahatte sorunları açıklayıp yardım iste.","grammar":"past simple questions + polite requests","vocabulary":[["flight","uçuş"],["delay","gecikme"],["luggage","bagaj"],["lost","kayıp"],["ticket","bilet"],["station","istasyon"],["help","yardım"],["problem","sorun"]],"sentences":[["My flight is delayed.","Uçuşum gecikti."],["I lost my luggage.","Bagajımı kaybettim."],["Could you help me?","Bana yardım edebilir misiniz?"],["Where is the train station?","Tren istasyonu nerede?"]],"dialogue":["Can I help you?","Yes, I lost my luggage."],"listening":["My flight is delayed.","I lost my luggage.","Could you help me?","Where is the train station?"],"speaking":["Explain a travel problem.","Ask for help at a station."],"exercises":[{"type":"mcq","q":"What is luggage?","options":["bagaj","bilet","uçuş","istasyon"],"answer":0},{"type":"mcq","q":"Which request is polite?","options":["Could you help me?","Help me now.","You help me.","I help you?"],"answer":0},{"type":"translate","q":"Bagajımı kaybettim.","answer":"I lost my luggage."},{"type":"build","q":"Cümleyi kur.","parts":["you","could","help","me"],"answer":"Could you help me?"}]},{"id":10,"title":"Alışveriş ve İade","emoji":"🛍️","goal":"Ürün, fiyat ve iade hakkında konuş.","grammar":"too/enough; questions with how much","vocabulary":[["size","beden"],["price","fiyat"],["receipt","fiş"],["return","iade etmek"],["exchange","değiştirmek"],["cheap","ucuz"],["expensive","pahalı"],["fit","uymak"]],"sentences":[["How much does it cost?","Ne kadar tutuyor?"],["This shirt is too small.","Bu gömlek çok küçük."],["Can I return this item?","Bu ürünü iade edebilir miyim?"],["It doesn't fit me.","Bana uymuyor."]],"dialogue":["Can I exchange this?","Yes, do you have the receipt?"],"listening":["How much does it cost?","This shirt is too small.","Can I return this item?","It doesn't fit me."],"speaking":["Ask about a product price.","Return an item politely."],"exercises":[{"type":"mcq","q":"What do you need for many returns?","options":["receipt","passport","map","menu"],"answer":0},{"type":"mcq","q":"Choose the correct sentence.","options":["It doesn't fit me.","It don't fit me.","It not fit me.","It doesn't fits me."],"answer":0},{"type":"translate","q":"Bu ürün çok pahalı.","answer":"This product is too expensive."},{"type":"build","q":"Cümleyi kur.","parts":["can","I","return","this","item"],"answer":"Can I return this item?"}]},{"id":11,"title":"Fikirler ve Nedenler","emoji":"💬","goal":"Fikir belirt ve nedenini açıkla.","grammar":"because, but, so, although","vocabulary":[["think","düşünmek"],["agree","katılmak"],["disagree","katılmamak"],["because","çünkü"],["although","rağmen"],["important","önemli"],["useful","faydalı"],["interesting","ilginç"]],"sentences":[["I think it is useful.","Bence faydalı."],["I agree because it is simple.","Katılıyorum çünkü basit."],["I like it, but it is expensive.","Onu seviyorum ama pahalı."],["It is important, so I practice.","Önemli, bu yüzden pratik yapıyorum."]],"dialogue":["Do you agree?","Yes, because it is useful."],"listening":["I think it is useful.","I agree because it is simple.","I like it, but it is expensive.","It is important, so I practice."],"speaking":["Give your opinion about learning English.","Agree or disagree and give a reason."],"exercises":[{"type":"mcq","q":"Which word gives a reason?","options":["because","although","tomorrow","between"],"answer":0},{"type":"mcq","q":"Choose the natural sentence.","options":["I think it is useful.","I think is it useful.","I it think is useful.","Think I it useful."],"answer":0},{"type":"translate","q":"Bence bu çok faydalı.","answer":"I think this is very useful."},{"type":"build","q":"Cümleyi kur.","parts":["think","I","it","is","useful"],"answer":"I think it is useful."}]},{"id":12,"title":"A2 Tekrar ve Gerçek Hayat","emoji":"🏆","goal":"A2 becerilerini gerçek konuşmada birleştir.","grammar":"mixed A2 review","vocabulary":[["conversation","konuşma"],["practice","pratik"],["mistake","hata"],["improve","gelişmek"],["confident","kendine güvenen"],["natural","doğal"],["goal","hedef"],["progress","ilerleme"]],"sentences":[["I want to improve my English.","İngilizcemi geliştirmek istiyorum."],["I can have a simple conversation.","Basit bir konuşma yapabilirim."],["Mistakes help me learn.","Hatalar öğrenmeme yardımcı olur."],["I feel more confident now.","Şimdi kendime daha çok güveniyorum."]],"dialogue":["How is your English now?","I feel more confident and I practice every day."],"listening":["I want to improve my English.","I can have a simple conversation.","Mistakes help me learn.","I feel more confident now."],"speaking":["Introduce yourself and describe your English progress.","Have a short conversation about your daily life."],"exercises":[{"type":"mcq","q":"What is progress?","options":["ilerleme","gecikme","bagaj","hesap"],"answer":0},{"type":"mcq","q":"Choose the best sentence.","options":["I want to improve my English.","I want improve my English.","I wanting to improve English.","I want to improved my English."],"answer":0},{"type":"translate","q":"İngilizcemi geliştirmek istiyorum.","answer":"I want to improve my English."},{"type":"build","q":"Cümleyi kur.","parts":["want","I","to","improve","my","English"],"answer":"I want to improve my English."}]}],"review":{"skills":["vocabulary","grammar","listening","speaking","translation","sentence-building"],"masteryTarget":0.8,"finalTestQuestions":24},"contentAttribution":{"policy":"Original instructional examples created for Speakio A2 curriculum."}}